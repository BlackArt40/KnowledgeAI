# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.uploads/

# tesseract.js language data (downloaded at runtime)
.tessdata/
*.traineddata

# swagger-ui static assets (regenerated by postinstall -> scripts/tools/copy-swagger-ui.mjs)
/public/vendor/swagger-ui/

# development screenshots (not needed to build/run)
docs/screenshots/

# development planning docs (historical, not project docs)
docs/superpowers/

# generated test reports (output of running tests, not source)
tests/**/*测试报告.md

# OpenCode tool state
.omo/

# P6-3: 测试产物与工具目录
/playwright-report/
/test-results/
.playwright/
.claude/
.zcode/

# P7: SDK 运行缓存 + 静态分析工具产物
__pycache__/
*.pyc
.brooks-lint-history.json

# 本地测试数据准备（仅本地使用，不提交 GitHub）
/scripts/local/

# vitepress docs
/.vitepress/dist/
/.vitepress/cache/
# vitepress build generates timestamped config shims - never commit them
/.vitepress/*.timestamp-*.mjs
