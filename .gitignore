# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# V0 (Vue 3 重写): frontend/ 为独立 workspace 包，依赖在根 node_modules + 本地链接
/frontend/node_modules/
# frontend 构建产物（网关切流挂载用）
/frontend/dist/
# frontend Playwright 本地产物（CI artifact 已另行上传）
/frontend/test-results/
/frontend/playwright-report/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# the template IS the env reference (AGENTS.md) - commit it
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.uploads/

# tesseract.js language data (downloaded at runtime)
.tessdata/
*.traineddata

# swagger-ui static assets (regenerated by postinstall -> scripts/tools/copy-swagger-ui.mjs)
/public/vendor/swagger-ui/

# development screenshots (not needed to build/run)
docs/screenshots/

# development planning docs (historical, not project docs)
docs/superpowers/

# generated test reports (output of running tests, not source)
tests/**/*测试报告.md

# OpenCode tool state
.omo/

# P6-3: 测试产物与工具目录
/playwright-report/
/test-results/
.playwright/
.claude/
.zcode/

# P7: SDK 运行缓存 + 静态分析工具产物
__pycache__/
*.pyc
# 阶段 1 拆分：Python AI 服务本地虚拟环境（services/ai/.venv）
.venv/
# 阶段 4 拆分：Java 业务服务构建产物（services/business/target）
services/business/target/
.brooks-lint-history.json

# 本地测试数据准备（仅本地使用，不提交 GitHub）
/scripts/local/

# vitepress docs
/.vitepress/dist/
/.vitepress/cache/
# vitepress build generates timestamped config shims - never commit them
/.vitepress/*.timestamp-*.mjs

# smoke runner reports (scripts/smoke/run-all.ts)
/scripts/smoke/.report/

# 前端绞杀切流：apply 备份不提交（frontend-switch.conf 生成后随切流提交，留下审计轨迹）
deploy/nginx/routes.conf.bak

# agent tooling state / scratch artifacts (session-local, never source)
.mimosa/
.workbuddy/
_tmp_*
knowledgeai_ai.egg-info/
docker-compose.override.yml

# unplugin-vue-components 生成的全局组件类型（dev/build 写出的集合不同，别提交）
frontend/src/components.d.ts
