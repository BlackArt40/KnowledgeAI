    "test:smoke": "tsx scripts/smoke/run-all.ts --group lib",
    "test:smoke:all": "tsx scripts/smoke/run-all.ts --group all",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview"
  },
