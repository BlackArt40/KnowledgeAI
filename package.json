    "bullmq": "^5.80.2",
    "d3-force": "^3.0.0",
    "i18next": "^26.3.6",
    "ioredis": "^5.11.1",
    "jose": "^6.2.8",
    "mammoth": "^1.8.0",
    "minisearch": "^7.2.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "otplib": "^13.4.1",
    "pdfjs-dist": "^4.8.69",
    "pino": "^10.3.1",
