# ── 阶段 6 拆分部署环境变量示例（docker-compose.split.yml）──────────────────
# 用法：cp deploy/env.split.example deploy/.env.split 后填写。
# 密钥只在本文件（业务/AI 运行时环境变量）—— 不进前端构建产物（A6.5）。
#
# 必填：
AUTH_SECRET=change-me-to-a-long-random-secret
AI_INTERNAL_TOKEN=change-me-internal-token
#
# 可选（默认值见 docker-compose.split.yml）：
# GATEWAY_PORT=8088               # 网关宿主端口
# COOKIE_SECURE=true              # 生产 https 必须 true（6.1 Cookie Secure）
# QUEUE_MAX_DEPTH=100             # Agent 队列深度上限（背压，A5.7）
# AGENT_TASK_TIMEOUT_SECONDS=900  # 懒回收超时（A5.6）
# SSRF_ALLOW_PRIVATE_HOSTS=false  # webhook 本地接收器演练时才置 true
# USAGE_ALERT_QA_LIMIT=0          # usage.alert 阈值（0=按 plan）
# RATE_LIMIT_PER_MIN=60
# RATE_LIMIT_ANON_PER_MIN=20
# RATE_LIMIT_KB_PER_MIN=60
# S3_BUCKET=knowledgeai-uploads
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# OPENAI_API_KEY=                 # 留空 = 演示模式（本地抽取式生成）
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o
