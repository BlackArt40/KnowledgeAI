# ──────────────────────────────────────────────
# KnowledgeAI 环境变量模板
# 复制为 .env.local 并填写真实值
# 未配置的项会自动回退到本地演示模式
# ──────────────────────────────────────────────

# 应用
NEXT_PUBLIC_APP_NAME="KnowledgeAI"
# 公网访问地址（也作为密码重置/邮箱验证邮件里的链接 base）。
# 部署在反代/内网后必须显式设置，否则邮件链接会用请求 origin（可能是内网地址）。
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── 数据库 ──────────────────────────────────────────────
# 留空则使用内存存储(globalThis, 重启即失)
# 配置后:启动时从 DB 水合内存,写入时持久化到 DB(向下兼容,不配则回退内存模式)
# 启用步骤:
#   1) 准备一个 PostgreSQL 数据库并填入下面的连接串
#   2) npx prisma migrate deploy   # 建表(使用 prisma/migrations 下的迁移)
#   3) npx prisma db seed          # 写入演示数据(可选)
DATABASE_URL=""

# ── 认证 ────────────────────────────────────────────────
AUTH_SECRET="change-me-to-a-random-32-char-string"

# ── 邮件 (P8, 密码重置) ──────────────────────────────────────────────────
# 配置后忘记密码流程通过后台队列异步投递邮件（固定投递到 Resend 云端 API）；
# 未配置 = 演示模式，重置链接直接返回在响应 body 中（仅本地开发，生产环境
# 统一响应防枚举）。投递失败按队列重试（3 次指数退避）。
RESEND_API_KEY=""
EMAIL_FROM=""                  # 发件地址，如 "KnowledgeAI <noreply@yourdomain.com>"

# ── OAuth 社交登录 (P3-2, Auth.js v5) ────────────────────────────────────
# 配置后登录/注册页显示 Google / GitHub 一键登录；未配置 = 按钮隐藏。
# 在 Google Cloud Console / GitHub OAuth Apps 创建应用，回调地址为
#   {AUTH_URL}/api/auth/callback/google  与  {AUTH_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# 服务自身地址（Auth.js baseUrl，默认取请求 Host；部署在反代后时显式设置）
AUTH_URL="http://localhost:3000"
# 测试/自托管代理：将 provider 指向自定义 issuer（OIDC discovery 根），
# 如 GOOGLE_ISSUER="http://127.0.0.1:5092"（acceptance 测试用 mock）
GOOGLE_ISSUER=""
GITHUB_ISSUER=""

# ── 安全审计 (P3-4) ──────────────────────────────────────────────────────
# Append-only audit trail (SecurityAudit) with a tamper-evident HMAC chain
# (keyed by AUTH_SECRET). Retention: entries older than AUDIT_RETENTION_DAYS
# are dropped by the admin cleanup endpoint (POST /api/admin/cleanup).
AUDIT_RETENTION_DAYS="90"         # audit log retention (default 90 days)
AUDIT_MAX_ENTRIES="2000"          # in-memory audit trail cap (default 2000)

# ── 可观测性 (P6-1) ──────────────────────────────────────────────────────
# Sentry DSN (https://<key>@<host>/<projectId>). When set, frontend + backend
# errors are forwarded to Sentry via the standard Envelope protocol (zero-dep
# direct POST, no SDK). Unset = errors stay in the in-memory ring and the
# /admin/monitoring dashboard only.
SENTRY_DSN=""

# ── 结构化日志 (P6-2) ─────────────────────────────────────────────────────
# pino 日志级别: debug | info | warn | error（默认 info；低于该级别的日志被丢弃）
LOG_LEVEL="info"
# Loki 日志聚合: 设置后按批量推送到 <url>/loki/api/v1/push（JSON Push API）。
# 未设置 = 仅 stdout JSON 行（演示模式）。ELK 可经同类 HTTP sink 适配。
LOG_LOKI_URL=""
# 额外脱敏字段（逗号分隔的 pino redact 路径，追加到内置敏感键表
# apiKey/password/token/secret/authorization/cookie 等及一二级嵌套通配）
LOG_REDACT_KEYS=""

# ── LLM / 嵌入模型 ──────────────────────────────────────
# 留空则使用本地哈希嵌入 + 抽取式生成(演示模式)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
EMBEDDING_MODEL="text-embedding-3-small"
CHAT_MODEL="gpt-4o"

# ── 向量数据库 ──────────────────────────────────────────
# memory(默认) | pgvector
# pgvector 需要先在 PostgreSQL 中执行: CREATE EXTENSION vector;
VECTOR_STORE="memory"  # memory | pgvector | chromadb
# CHROMA_URL="http://localhost:8000"  # ChromaDB REST API (仅 VECTOR_STORE=chromadb 时使用)
# PINECONE_API_KEY=""  # Pinecone API key (仅 VECTOR_STORE=pinecone 时使用)
# PINECONE_INDEX_HOST=""  # 如 https://idx-xxx.svc.region.pinecone.io (或用 PINECONE_INDEX_NAME 自动解析)

# ── 对象存储(文件上传) ──────────────────────────────────
# 留空则使用本地 .uploads/ 目录
# 配置后:文件上传至 S3/MinIO/R2,支持预签名 URL 直传
S3_ENDPOINT=""               # 如 https://s3.amazonaws.com 或 https://minio.local:9000
S3_BUCKET="knowledgeai-uploads"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"
S3_PUBLIC_URL=""             # 公开访问的 CDN/基础 URL(可选)
MAX_UPLOAD_MB="50"           # 单文件大小上限(MB)
# CHUNK_SIZE_MB=5  # 分片上传大小(MB, 默认5)
# MAX_CHUNKED_UPLOAD_MB=500  # 分片上传文件上限(MB, 默认500)

# ── 任务队列 ────────────────────────────────────────────
# 留空则使用内存队列(进程内,单实例)
# 配置后:使用 BullMQ + Redis(多实例,持久化,重试,死信队列)
REDIS_URL=""

# ── 限流 (P3-3 分级) ────────────────────────────────────────────────────
# Tiered rate limiting: one dimension per request (per minute, 60s window).
#   RATE_LIMIT_PER_MIN        - authenticated users (JWT)    (default 200)
#   RATE_LIMIT_ANON_PER_MIN   - anonymous requests by IP     (default 20)
#   RATE_LIMIT_KEY_PER_MIN    - API key holders              (default 500)
#   RATE_LIMIT_KB_PER_MIN     - per knowledge base (route layer; keep below
#                               the user limit so the KB tier triggers first)
#   RATE_LIMIT_INTEGRATION_PER_MIN - per third-party integration (P7-2: bot
#                               bindings / embedded widget; enforced in-route,
#                               independent of the owning user's quota)
# REDIS_URL set  -> Redis sliding window (multi-instance, global)
# REDIS_URL unset -> in-memory window (single-instance demo)
RATE_LIMIT_PER_MIN="200"
RATE_LIMIT_ANON_PER_MIN="20"
RATE_LIMIT_KEY_PER_MIN="500"
RATE_LIMIT_KB_PER_MIN="60"
RATE_LIMIT_INTEGRATION_PER_MIN="120"

# ── 支付网关 ────────────────────────────────────────────
# 留空则使用模拟支付
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO="price_xxx"        # 专业版 Stripe Price ID
STRIPE_PRICE_ENT="price_xxx"        # 企业版 Stripe Price ID

# ── 系统配置 ────────────────────────────────────────────
MAINTENANCE_MODE="false"
ALLOW_SIGNUP="true"

# ── OCR (scanned PDF / image text recognition) ────────────────────────────
# Self-contained via tesseract.js (WASM) + pdfjs-dist + @napi-rs/canvas.
# Used automatically when a PDF has no text layer (scanned) or for image uploads.
OCR_ENABLED="true"                # master switch; false skips all OCR (digital-only fast path)
OCR_LANG="eng+chi_sim"            # tesseract language pack(s), '+'-joined (CJK + English default)
OCR_MAX_PAGES="20"                # cap pages OCR'd per scanned PDF (bounds worker time)

# ── RAG 检索增强 (Reranking + Query Rewrite) ──────────────────────────────
# LLM-based reranking and multi-query fusion. Requires LLM provider configured.
# Falls back to no-op (original retrieval order) in demo mode.
RERANK_ENABLED="true"             # LLM-based reranking of retrieval candidates
RERANK_CANDIDATES="20"            # candidate pool size before reranking
QUERY_REWRITE_ENABLED="true"      # LLM-based multi-query fusion (synonym expansion)
QUERY_REWRITE_COUNT="3"           # number of rewritten queries to generate

# ── 智能切片 (P1-3) ──────────────────────────────────────────────────────
# Dynamic chunking is always enabled (adjusts chunk size by content density).
# Parent-child chunking: indexes small child chunks for precise retrieval,
# returns larger parent chunks for generation context. Off by default.
PARENT_CHILD_CHUNKING="false"     # enable parent-child chunking strategy

# ── 外部数据源 (P2-2) ───────────────────────────────────────────────────
# External data sources: web search, ArXiv, GitHub. Used by:
# - Agent research: searcher node queries both internal KB and external sources.
# - Chat "联网搜索" toggle: merges external Web results into the RAG context
#   so answers can cite web URLs (sources event carries url/sourceType).
# All sources have demo fallbacks (return mock results when no API key set).
TAVILY_API_KEY=""                 # Tavily search API (best for RAG, returns clean content)
SERPAPI_KEY=""                    # SerpAPI (Google search results API)
BRAVE_SEARCH_KEY=""               # Brave Search API
GITHUB_TOKEN=""                   # GitHub token (optional, for higher rate limit; ArXiv is free)

# ── 文档同步 (P7-2: Notion / Confluence) ─────────────────────────────────
# Notion 集成 Token（My integrations -> Internal integration secret）。
# 也可在同步请求体传 token 覆盖。NOTION_API_URL 供测试/代理覆写。
NOTION_TOKEN=""
NOTION_API_URL=""
# Confluence Cloud：站点地址 + API Token（PAT），Basic auth = EMAIL:TOKEN。
CONFLUENCE_BASE_URL=""
CONFLUENCE_EMAIL=""
CONFLUENCE_TOKEN=""
