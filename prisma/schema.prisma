// KnowledgeAI - Prisma schema for PostgreSQL
// Production database schema. Run: npx prisma migrate deploy
// 🔌 The in-memory stores (src/lib/*/store.ts) act as a write-through cache.
//    On startup, data is hydrated from DB (src/lib/db/hydrate.ts).
//    On mutation, changes are persisted to DB (src/lib/db/persist.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth & Users ──────────────────────────────────────────
model User {
  id               String     @id @default(cuid())
  email            String     @unique
  name             String
  passwordHash     String?
  role             Role       @default(EDITOR)
  status           UserStatus @default(ACTIVE)
  plan             String     @default("free")
  twoFactorEnabled Boolean    @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  // P5-4: preferred UI language ("zh-CN" | "en")
  locale           String     @default("zh-CN")
  // P3-2: social login links, JSON map provider -> providerAccountId
  // (e.g. {"google":"1177...","github":"4821..."}). Null when the user has
  // no linked OAuth identity. OAuth-only accounts keep passwordHash null.
  oauthLinks       Json?

  teamMemberships TeamMember[]
  apiKeys         ApiKey[]
  loginEvents     LoginEvent[]
  ownedKbs        KnowledgeBase[] @relation("OwnedKBs")
  conversations   Conversation[]
  agentTasks      AgentTask[]
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  BANNED
  TRIAL
}

// ── Teams ─────────────────────────────────────────────────
model Team {
  id          String          @id @default(cuid())
  name        String
  logoInitial String          @default("K")
  plan        String          @default("专业版")
  kbAccess    Json            @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     TeamMember[]
  kbs         KnowledgeBase[]
  auditLogs   AuditLog[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     Role     @default(EDITOR)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
}

// ── Workspaces (P4-3 tenants / P5-5 theme) ─────────────────
// P5-5: persistence row for the in-memory workspace store (src/lib/workspace/
// store.ts). `brandColor` drives the workspace-level theme (see
// src/lib/theme/brand-colors.ts). Members stay memory-only for now - there is
// no member relation on this table yet.
model Workspace {
  id         String   @id
  name       String
  plan       String   @default("free")
  ownerId    String
  brandColor String   @default("indigo")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  teamId    String
  actorId   String?
  actor     String   @default("")
  target    String   @default("")
  action    String
  detail    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ── Knowledge Base ────────────────────────────────────────
model KnowledgeBase {
  id          String       @id @default(cuid())
  name        String
  description String?
  desc        String       @default("")
  color       String       @default("from-primary/15")
  initial     String       @default("K")
  ownerId     String
  teamId      String?
  settings    Json         @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  owner       User         @relation("OwnedKBs", fields: [ownerId], references: [id])
  team        Team?        @relation(fields: [teamId], references: [id])
  documents   KbDocument[]
}

model KbDocument {
  id         String        @id @default(cuid())
  kbId       String
  name       String
  size       Int
  type       String
  status     String        @default("queued")
  progress   Int           @default(0)
  content    String?
  url        String?
  chunks     Int           @default(0)
  kb         KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  uploadedAt DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([kbId])
}

// ── Chat ──────────────────────────────────────────────────
model Conversation {
  id          String    @id @default(cuid())
  kbId        String
  userId      String
  title       String
  messages    Message[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // P5-3: persisted P4-1/P4-3 fields (were memory-only) + archive/tags
  shared      Boolean   @default(false)
  workspaceId String    @default("ws_default")
  archived    Boolean   @default(false)
  tags        String[]  @default([])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  citations      Json?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  // P5-3: like/dislike feedback (used to down-weight cited docs in later retrievals)
  feedback       String?
  feedbackNote   String?
  feedbackAt     DateTime?
}

// ── Agent ─────────────────────────────────────────────────
model AgentTask {
  id           String   @id @default(cuid())
  userId       String
  topic        String
  kbId         String?
  kbName       String?
  outputFormat String   @default("report")
  status       String   @default("pending")
  // P2-1/P4-3: workflow config + tenant - memory-only until now, needed by
  // the separate worker process (cross-process hydration).
  agents       Json?
  maxSteps     Int      @default(5)
  template     String?
  workspaceId  String   @default("ws_default")
  report       String?
  outline      Json?
  citations    Json?
  steps        Json?
  durationMs   Int?
  shareConfig  Json?
  versions     Json?
  comments     Json?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Billing ───────────────────────────────────────────────
model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  plan              String   @default("free")
  status            String   @default("active")
  periodStart       DateTime
  periodEnd         DateTime
  cancelAtPeriodEnd Boolean  @default(false)
  paymentMethod     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Invoice {
  id     String   @id @default(cuid())
  userId String
  amount Int
  plan   String
  status String   @default("paid")
  method String
  date   DateTime @default(now())
}

// ── API Keys ──────────────────────────────────────────────
model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String
  // P3-4: holds the AES-256-GCM ciphertext (encryptToString) of the secret -
  // never the plaintext. Legacy plaintext rows pass through on validation.
  keyHash   String    @unique
  prefix    String
  scopes    String[]
  status    String    @default("active")
  calls     Int       @default(0)
  lastUsed  DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

// ── Security ──────────────────────────────────────────────
// P3-4: append-only audit trail. Each row links to the previous one via
// prevHash; hash = HMAC-SHA256(prevHash|fields|createdAt, AUTH_SECRET) so any
// tampering breaks verifyAuditChain(). Rows are trimmed by AUDIT_RETENTION_DAYS.
model SecurityAudit {
  id        String   @id @default(cuid())
  actorId   String?
  actor     String   @default("")
  action    String
  target    String   @default("")
  detail    String
  ip        String?
  prevHash  String
  hash      String
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  device    String
  ip        String
  location  String?
  success   Boolean
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ── Vector Chunks (for pgvector) ──────────────────────────
// Created automatically by PgVectorStore when VECTOR_STORE=pgvector.
// Requires: CREATE EXTENSION IF NOT EXISTS vector;
model KbChunk {
  id         String   @id @default(cuid())
  kbId       String
  docId      String
  docName    String
  chunkIndex Int
  text       String
  // embedding column is added via raw SQL (vector type) since Prisma
  // doesn't natively support pgvector types in schema.
  createdAt  DateTime @default(now())

  @@index([kbId])
  @@index([docId])
}

// ── Notifications ────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // emailDigest | kbReady | agentDone | securityAlert
  title     String
  body      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model NotificationPrefs {
  userId        String  @id
  emailDigest   Boolean @default(false)
  kbReady       Boolean @default(true)
  agentDone     Boolean @default(true)
  securityAlert Boolean @default(true)
}

// ── External Model Configs (per-user LLM provider settings) ──────────────
model ModelConfig {
  id             String    @id @default(cuid())
  userId         String
  name           String
  provider       String // openai | deepseek | moonshot | siliconflow | ollama | custom
  providerName   String
  apiKey         String // 🔌 encrypt with AES-256-GCM in production
  baseUrl        String
  chatModel      String
  embeddingModel String    @default("")
  enabled        Boolean   @default(true)
  isDefault      Boolean   @default(false)
  lastTestedAt   DateTime?
  lastTestOk     Boolean?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

// ── Billing Orders ───────────────────────────────────────────────────────
model Order {
  id        String   @id @default(cuid())
  userId    String
  plan      String // free | pro | enterprise
  amount    Int
  method    String // wechat | alipay | card
  status    String   @default("pending") // pending | paid | failed
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Admin System Config (single-row, admin-tunable settings) ─────────────
model SystemConfig {
  id               Int      @id @default(1)
  defaultModel     String   @default("gpt-4o")
  embeddingModel   String   @default("bge-m3")
  rateLimitPerMin  Int      @default(60)
  maxUploadMb      Int      @default(50)
  maintenanceMode  Boolean  @default(false)
  allowSignup      Boolean  @default(true)
  required2FARoles String[] @default([])
  updatedAt        DateTime @updatedAt
}

// ── P7-1: Outgoing webhook subscriptions ─────────────────────────────────
// User-configured HTTPS endpoints that receive HMAC-SHA256-signed event
// notifications (kb.ready / agent.completed / usage.alert). Delivery is
// fire-and-forget via the job queue (webhook-deliver) with retries; `failures`
// + `lastError` track the dead-letter state. See src/lib/webhooks/.
model WebhookSubscription {
  id             String    @id @default(cuid())
  userId         String
  workspaceId    String    @default("ws_default")
  name           String
  url            String
  secret         String    @default("")
  events         String[]
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  lastDeliveryAt DateTime?
  failures       Int       @default(0)
  lastError      String?

  @@index([workspaceId])
}

// ── P7-2: Chat-bot integrations (Slack / 飞书 / 钉钉) ────────────────────
// One row per bot binding: a KB tied to a platform webhook endpoint. The
// callback token is stored SHA-256-hashed (never plaintext); each bot has its
// own rate-limit tier. See src/lib/integrations/bots.ts.
model BotIntegration {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String   @default("ws_default")
  name        String
  platform    String // slack | feishu | dingtalk | test
  kbId        String
  kbName      String   @default("")
  tokenHash   String
  active      Boolean  @default(true)
  calls       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

// ── P7-3: Knowledge graph (entities + relations) ─────────────────────────
// NER-extracted entities and sentence co-occurrence relations per KB, used by
// the graph visualization and GraphRAG hybrid retrieval. See src/lib/kg/.
model KnowledgeEntity {
  id        String   @id @default(cuid())
  kbId      String
  label     String
  type      String // person | organization | concept | event
  mentions  Int      @default(1)
  docIds    String[]
  createdAt DateTime @default(now())

  @@index([kbId])
}

model KnowledgeRelation {
  id        String   @id @default(cuid())
  kbId      String
  source    String
  target    String
  type      String   @default("co-occurs")
  weight    Int      @default(1)
  docIds    String[]
  createdAt DateTime @default(now())

  @@index([kbId])
}
